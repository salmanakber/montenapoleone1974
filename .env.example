# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Owner emergency override passcode (if unset, claim Owner password in the Admin UI on first run)
ADMIN_PASSCODE=

# Session signing secret (falls back to runtime random secret if unset)
SESSION_SECRET=

# Payment Gateways (set via Settings -> Secrets for live transactions)
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MERCHANT_SERIAL_NUMBER=

# DHL Express API Credentials
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT_NUMBER=

# Mailchimp Marketing API (for newsletter & audience sync)
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_LIST_ID=

# OpenAI API (optional alternative provider selectable in Admin AI Settings)
OPENAI_API_KEY=

# Resend Email Delivery (transactional order confirmation & DHL tracking emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Monte Napoleone 1974 <orders@montenapoleone1974.com>"

# Wix Commerce Onboarding OAuth
WIX_CLIENT_ID=
WIX_CLIENT_SECRET=
WIX_SITE_ID=

# Optional IP Geolocation API key for Shopify-style live 3D visitor globe (e.g. ipinfo.io token)
GEOIP_API_KEY=

# Google / Gmail Client OAuth Login (configurable here or in Admin -> API Vault)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional custom production domain (e.g. https://montenapoleone1974.com) for OAuth callback & SEO canonicals
PUBLIC_DOMAIN_URL=
